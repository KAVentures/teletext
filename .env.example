# Optional X API token. The current v1 live path uses Grok's server-side
# X Search because standard X API access does not expose the legacy trends endpoint.
# Keep this for a future official-trends adapter if your X tier supports one.
X_BEARER_TOKEN=
# Optional: set true to use the paid X recent-search API for topic searches.
# Default false because the x.com-restricted Grok web-search path is cheaper in current tests.
X_DIRECT_TOPIC_SEARCH=false

# xAI Responses API
XAI_API_KEY=
XAI_MODEL=grok-4.7

# Cost policy
# Global X evidence is regenerated at most every 4 hours.
# Topic searches are reused for 24 hours.
# Non-English editions translate cached English evidence; they do not re-search X.
GLOBAL_REVALIDATE_SECONDS=14400
TOPIC_REVALIDATE_SECONDS=86400
