# Optional X API token. Not required for the default My X path.
X_BEARER_TOKEN=
X_DIRECT_TOPIC_SEARCH=false

# xAI Responses API
XAI_API_KEY=
XAI_MODEL=grok-4.7

# Global news is generated by GitHub Actions from an XAI_API_KEY repository secret.
# The production web app reads only the checked-in daily snapshot (zero paid
# global-generation or translation calls from visitors).
# The Vercel XAI_API_KEY below remains used for on-demand My X profile queries.
#
# Cost policy used by the app:
# - worldwide edition and its translations: generated together once per UTC day
# - each X profile: shared for 7 days
# - max 5 profiles per personal edition
# - one X-search tool turn, parallel tool calls disabled
