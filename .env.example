# X API
# App-only bearer token. Keep this server-side.
X_BEARER_TOKEN=
# 1 = worldwide. Can be changed to another WOEID later.
X_WOEID=1
# The number of X trend names fed into the discovery search.
X_MAX_TRENDS=6
# Single recent-search request. 10 is the minimum accepted by X recent search.
X_POST_SAMPLE_SIZE=20
# en, sv, etc. Leave blank to avoid a language filter.
X_LANGUAGE=en

# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# Set false to stop the editor from verifying X-discovered stories on the open web.
OPENAI_WEB_SEARCH=true

# Edition cache TTL in seconds. Used as documentation; the current build caches for 15 minutes.
EDITION_REVALIDATE_SECONDS=900
