# Optional X API token. The current v1 live path uses Grok's server-side
# X Search because standard X API access does not expose the legacy trends endpoint.
# Keep this for a future official-trends adapter if your X tier supports one.
X_BEARER_TOKEN=

# xAI Responses API
XAI_API_KEY=
XAI_MODEL=grok-4.6
# Set false to stop Grok from verifying X-discovered stories on the open web.
XAI_WEB_SEARCH=true

# Edition cache TTL in seconds. Used as documentation; the current build caches for 15 minutes.
EDITION_REVALIDATE_SECONDS=900
