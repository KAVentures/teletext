# Optional X API token. Not required for the default My X path.
X_BEARER_TOKEN=
X_DIRECT_TOPIC_SEARCH=false

# xAI Responses API
XAI_API_KEY=
XAI_MODEL=grok-4.7

# Cost policy used by the app:
# - worldwide edition: shared for 24 hours
# - each X profile: shared for 7 days
# - max 5 profiles per personal edition
# - one X-search tool turn, parallel tool calls disabled
